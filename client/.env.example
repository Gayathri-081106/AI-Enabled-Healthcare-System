# Production & Development Environment Configuration for Vite React Client
# In development, leave blank to default to http://localhost:5000/api
# In production, set to your deployed backend HTTPS endpoint, e.g.:
# VITE_API_BASE_URL=https://mediconnect-api.onrender.com/api
VITE_API_BASE_URL=

# Teleconsultation WebSocket Signaling URL
# If omitted, automatically derived from VITE_API_BASE_URL or window.location (wss:// on https, ws:// on http)
# VITE_WS_URL=wss://mediconnect-api.onrender.com/ws
VITE_WS_URL=

# Optional WebRTC STUN/TURN server configuration JSON string
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
VITE_ICE_SERVERS=
